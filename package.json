{
  "name": "depress-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "De-press yourself. WordPress to Astro + Keystatic migration tool.",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@depress-org/core --workspace=@depress-org/wp-migrate --workspace=@depress-org/depress --if-present && npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "node scripts/test-workspaces.mjs",
    "test:unit": "npm run test --workspaces --if-present",
    "test:coverage": "npm test",
    "test:integration": "node scripts/generated-site.mjs",
    "test:media-archive": "node scripts/media-archive-site.mjs",
    "test:oss-packaging": "node scripts/oss-consumer.mjs",
    "test:oss-consumer": "node scripts/oss-consumer.mjs --require-default-build",
    "test:gate": "node scripts/verify-coverage-gate.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "find . -name 'dist' -type d -not -path '*/node_modules/*' | xargs rm -rf"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@astrojs/sitemap": "3.2.1",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "^5.4.0",
    "vitest": "4.1.12"
  }
}
