{
  "name": "@depress-org/job-core",
  "version": "0.1.0",
  "description": "Shared upload -> migrate -> deploy job orchestration used by packages/web and packages/telegram-bot",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
