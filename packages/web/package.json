{
  "name": "@depress-org/web",
  "version": "0.1.0",
  "description": "depress web scaffold: upload WXR -> pick theme -> migrate -> deploy, with job progress (staging/local only, no billing yet)",
  "type": "module",
  "private": true,
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "license": "MIT",
  "dependencies": {
    "@depress-org/job-core": "*",
    "@depress-org/wp-migrate": "*",
    "@hono/node-server": "^1.13.0",
    "busboy": "1.6.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/depress-org/depress.git",
    "directory": "packages/web"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
