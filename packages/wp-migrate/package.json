{
  "name": "@depress-org/wp-migrate",
  "version": "0.1.0",
  "description": "WordPress migration engine for depress — converts WXR exports to Astro + Keystatic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__/**",
    "!dist/**/__fixtures__/**",
    "!dist/**/*.test.*",
    "README.md",
    "bundled-themes/astrowind/LICENSE.md",
    "bundled-themes/astrowind/README.md",
    "bundled-themes/astrowind/package.json",
    "bundled-themes/astrowind/astro.config.ts",
    "bundled-themes/astrowind/tailwind.config.js",
    "bundled-themes/astrowind/tsconfig.json",
    "bundled-themes/astrowind/src",
    "!bundled-themes/astrowind/src/data/**",
    "bundled-themes/astrowind/vendor/integration",
    "bundled-themes/astrowind/public/robots.txt",
    "bundled-themes/astrowind/public/_headers"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "license": "MIT",
  "dependencies": {
    "@depress-org/core": "^0.1.0",
    "@markdoc/markdoc": "0.4.0",
    "chalk": "^5.0.0",
    "fast-xml-parser": "^4.0.0",
    "gray-matter": "^4.0.0",
    "slugify": "^1.6.0",
    "turndown": "^7.0.0",
    "wordpress-export-to-markdown": "^3.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/turndown": "^5.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "^5.4.0",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/depress-org/depress.git",
    "directory": "packages/wp-migrate"
  },
  "keywords": [
    "wordpress",
    "migration",
    "astro",
    "keystatic",
    "wxr",
    "markdown"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
