{
  "name": "depress-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "De-press yourself. WordPress to Astro + Keystatic migration tool.",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@depress-org/core --workspace=@depress-org/wp-migrate --workspace=@depress-org/depress --if-present && npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "node scripts/test-workspaces.mjs",
    "test:unit": "npm run test --workspaces --if-present",
    "test:coverage": "npm test",
    "test:integration": "node scripts/generated-site.mjs",
    "test:media-archive": "node scripts/media-archive-site.mjs",
    "test:gate": "node scripts/verify-coverage-gate.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "find . -name 'dist' -type d -not -path '*/node_modules/*' | xargs rm -rf"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1",
    "npm": "^10.8.2 || ^11.21.1"
  },
  "devDependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "^5.4.0",
    "vitest": "4.1.12",
    "vite": "8.3.5",
    "astro": "7.4.2",
    "@astrojs/cloudflare": "14.4.2",
    "@astrojs/markdoc": "2.1.1",
    "@astrojs/react": "7.1.1",
    "@keystatic/astro": "6.0.0",
    "@keystatic/core": "0.6.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "yaml": "2.9.1",
    "wrangler": "4.152.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7"
  },
  "overrides": {
    "miniflare@5.20261019.2-beta": {
      "undici": "7.30.1"
    }
  }
}
