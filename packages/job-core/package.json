    "test:watch": "vitest"
  },
  "license": "MIT",
  "dependencies": {
    "@depress-org/core": "*",
    "@depress-org/depress": "*",
    "@depress-org/wp-migrate": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/depress-org/depress.git",
    "directory": "packages/job-core"
  },
  "engines": { "node": ">=18.0.0" }
}
